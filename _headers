/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-PRG2G5HdQCgydoZeoPjeABcVUK5Ot7c7BhRTXDOf2AE='; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src *; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# El sitio no lleva huella en los nombres de archivo, así que el navegador tiene que
# preguntar antes de reusar lo que guardó: si no, un despliegue nuevo tarda en verse.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/site.webmanifest
  Cache-Control: no-cache
