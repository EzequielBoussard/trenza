/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-X9uKCvhNTvJ4CJevO1R68RbKt0yzeyI/Z+RKCI/NwuQ='; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Los nombres de archivo no llevan hash: hay que revalidar para ver cada despliegue.
/
  Cache-Control: no-cache
/demo
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/site.webmanifest
  Cache-Control: no-cache

# El nombre de cada fuente ya identifica familia, peso y subconjunto; no cambian.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Iconos y archivos del ejemplo casi no cambian: un día de caché evita un 304 por visita.
/*.png
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
/showcase/*
  Cache-Control: public, max-age=86400
